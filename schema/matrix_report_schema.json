{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "03.01.matrix_report",
  "title": "Competency Goal Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_date", "full_name", "current_grade", "results"],
  "properties": {
    "report_date": {
      "type": "string",
      "format": "date",
      "description": "Дата отчёта в формате YYYY-MM-DD"
    },
    "full_name": {
      "type": "string",
      "minLength": 1,
      "description": "Фамилия и Имя сотрудника"
    },
    "current_grade": {
      "type": "string",
      "minLength": 1,
      "description": "Текущий грейд сотрудника"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "competency_name",
          "competency_id",
          "to_be_value",
          "as_is_value",
          "evidence",
          "conclusion",
          "achievement_percent"
        ],
        "properties": {
          "competency_name": { "type": "string" },
          "competency_id": { "type": "string" },
          "to_be_value": {
            "oneOf": [{ "type": "number" }, { "type": "string" }]
          },
          "as_is_value": {
            "oneOf": [{ "type": "number" }, { "type": "string" }]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "conclusion": { "type": "string" },
          "achievement_percent": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
